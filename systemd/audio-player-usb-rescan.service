[Unit]
Description=Rescan USB audio library after mount change
After=audio-player-backend.service
Wants=audio-player-backend.service

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'test -d /media/usb && curl -sf -m 20 -X POST http://127.0.0.1/api/usb/scan || curl -sf -m 20 -X POST http://127.0.0.1:8000/api/usb/scan || true'
RemainAfterExit=no

[Install]
WantedBy=multi-user.target